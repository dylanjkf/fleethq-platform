# Copy to .env for local development. Never commit a real .env.

# Used by `prisma migrate` / `prisma generate` — connects as the schema-owning role
# so it can create/alter tables and RLS policies.
DATABASE_URL="postgresql://fleetos:fleetos_dev_only@localhost:5432/fleetos?schema=public"

# Used by the running API at request time — connects as a low-privilege role with
# no BYPASSRLS, so every query is actually subject to the row-level security
# policies defined in the RLS migration. Row-level access control only holds as a
# non-negotiable constraint (11-Database/Data_Model.md) if the app can't bypass it.
APP_DATABASE_URL="postgresql://fleetos_app:fleetos_app_dev_only@localhost:5432/fleetos?schema=public"
# At a single app instance, Prisma's default pool (num_cpus*2+1) is fine and
# this doesn't need to be set. Once running more than one instance behind a
# load balancer, add `&connection_limit=<N>` to this URL sized so
# (instances × N) stays well under your Postgres plan's max_connections —
# e.g. `?schema=public&connection_limit=10`. See
# 02-Architecture/Scaling_And_Enterprise_Readiness.md for the full guidance
# (PgBouncer / a managed pooler becomes the better fix beyond a few instances).

# Used ONLY by AuthService's initial username lookup at login, before any
# tenant/user context exists — see the "fleetos_auth" comment in
# prisma/migrations/20260713080000_admin_entities_and_users_rls/migration.sql.
# This role bypasses RLS but is granted SELECT on the `users` table and
# nothing else at all — narrower than APP_DATABASE_URL, not broader.
AUTH_DATABASE_URL="postgresql://fleetos_auth:fleetos_auth_dev_only@localhost:5432/fleetos?schema=public"

# Used ONLY by the FleetHQ internal administration platform (21-Admin-Platform/
# Overview.md) — a completely separate role from the three above, with
# BYPASSRLS but narrowly-scoped explicit grants (only the admin_* tables plus
# the read access it needs on customer tables for cross-tenant admin views).
# A customer-facing request can never use this connection: AdminPrismaService
# is the only thing that reads this URL, and it's wired only into
# AdminAuthModule and future /admin/v1 modules.
ADMIN_DATABASE_URL="postgresql://fleetos_admin:fleetos_admin_dev_only@localhost:5432/fleetos?schema=public"

# Signing secret for scoped session JWTs (12-API/API_Architecture.md: "Authentication
# uses scoped tokens (per user, per company context)"). Generate a real random value
# per environment — never reuse this placeholder outside local dev.
JWT_SECRET="local-dev-only-change-me"
JWT_EXPIRES_IN="12h"

# bcrypt work factor for password / MFA-backup-code hashing. Default 12 (current
# OWASP baseline). Existing hashes encode their own cost and stay valid, so this
# only affects newly created hashes — raise it as hardware improves. Clamped to
# 10..15 in code.
BCRYPT_COST="12"

# Separate signing secret for admin-platform session JWTs — deliberately
# distinct from JWT_SECRET (and registered under its own Passport strategy
# name, 'admin-jwt') so a customer session token can never be replayed
# against an /admin/v1 route, or vice versa, even under a guard
# misconfiguration.
ADMIN_JWT_SECRET="local-dev-only-change-me-admin"
ADMIN_JWT_EXPIRES_IN="12h"

PORT=3000

# Web Push (browser push notifications) — generate a real keypair per
# environment with `npx web-push generate-vapid-keys`, never reuse this one.
# VAPID_SUBJECT must be a mailto: address or https: URL the push service can
# contact if it needs to reach the sender. Both are safe to be absent: push
# just stays unavailable (GET /v1/push/vapid-public-key returns null) rather
# than the app failing to start.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"

# Error tracking (see src/instrument.ts). Empty/unset is a safe, fully
# supported no-op — Sentry only activates once a real DSN from a real Sentry
# project is set (see infra/terraform/modules/secrets).
SENTRY_DSN=""

# Billing (see src/billing/, 19-Billing/Billing_And_Subscriptions.md). Both
# empty/unset is a safe, fully supported no-op — GET /v1/billing/status still
# works (reports billingConfigured: false); checkout/portal-session creation
# and the webhook both fail clearly with BILLING_NOT_CONFIGURED instead of a
# confusing Stripe SDK error. Use Stripe's own test-mode keys (sk_test_...)
# during development — never put a live secret key in this file.
STRIPE_SECRET_KEY=""
# From the Stripe Dashboard's webhook endpoint config (or `stripe listen` in
# local dev) — verifies POST /v1/billing/webhook actually came from Stripe.
STRIPE_WEBHOOK_SECRET=""
# Plan enforcement (entitlements). Off by default so dev/CI/pilot are
# unlimited; set BILLING_ENFORCED=true in production to actually enforce a
# subscribed company's plan limits/features. The price ids below map a
# company's Stripe planPriceId to a tier (Starter/Pro/Enterprise); leave a
# tier's id blank to disable that tier.
BILLING_ENFORCED=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""
# Per-asset billing (19-Billing/Per_Asset_Billing.md): the Stripe recurring
# Price id for the $19 AUD/asset/month plan (licensed/quantity usage type).
# When a company's planPriceId matches this, its hard asset cap is the
# purchased Stripe subscription quantity (Company.assetQuantity), not a fixed
# tier constant. Leave blank if not selling the per-asset plan. The $ amount
# itself lives in the billing_settings table (one source of truth), not here —
# this is only the Stripe Price handle.
STRIPE_PRICE_PER_ASSET=""
# GST/Australian tax invoicing (Auth/Billing Platform Phase 8). Off by
# default — setting this to "true" adds automatic_tax + tax_id_collection to
# Checkout Sessions, which Stripe REJECTS as an API error unless Stripe Tax
# has actually been enabled and an Australian GST registration configured in
# the Stripe Dashboard first (a real business/compliance step, not a code
# change — see 19-Billing/Billing_And_Subscriptions.md's go-live checklist).
# Only flip this on after that registration is live.
STRIPE_TAX_ENABLED=""
# Stripe Billing Portal configuration id (bpc_...). Optional but RECOMMENDED in
# production. The customer billing portal's plan-switching must be restricted to
# the same prices sold at checkout (STRIPE_PRICE_* above) — otherwise, if
# plan-switching is enabled on the Stripe Dashboard's DEFAULT portal config, a
# customer could switch to any price in the account, bypassing the server-side
# checkout allowlist. When set, the portal uses this configuration. When left
# blank, the API builds/reuses a fleetos-managed configuration automatically
# (restricted to the STRIPE_PRICE_* allowlist); managing one out of band and
# pinning its id here is the more predictable production posture.
STRIPE_PORTAL_CONFIGURATION_ID=""
# Optional public policy URLs shown in the auto-created billing portal
# configuration. Default to APP_BASE_URL + /privacy and /terms when unset.
PRIVACY_POLICY_URL=""
TERMS_OF_SERVICE_URL=""
# Retention window (days) for the Stripe webhook idempotency ledger
# (stripe_webhook_events). Defaults to 90. The ledger only needs to span
# Stripe's redelivery window; the scheduler purges rows older than this.
STRIPE_WEBHOOK_EVENT_RETENTION_DAYS=""

# Outbound email (notification digests, and the public contact form below).
# Unset/empty = the LoggingNotificationChannel is used (emails are only
# logged, never sent) — a safe no-op for local dev and CI. To actually send,
# set EMAIL_PROVIDER=ses and a verified SES EMAIL_FROM_ADDRESS;
# credentials/region come from the standard AWS sources (the ECS task role in
# production, AWS_REGION/profile locally). SES only.
EMAIL_PROVIDER=""
EMAIL_FROM_ADDRESS=""

# Where POST /v1/contact (the public "get in touch" form — FleetHQ has no
# self-service signup/trial, see src/contact/) delivers enquiries. Defaults
# to this address in code if unset.
CONTACT_EMAIL_TO="admin@fleethq.net.au"
# AWS_REGION is also used by SES (and any other AWS SDK client). In production
# ECS sets this; locally set it if you're testing real SES.
AWS_REGION="ap-southeast-2"

# Public FleetHQ origin used to build the links in verification/reset/invite
# emails. Defaults to the Vite dev server; set to the deployed FleetHQ URL in
# production so the emailed links point somewhere real.
APP_BASE_URL="http://localhost:5173"

# Comma-separated allowlist of browser origins allowed to call this API
# cross-origin (see src/main.ts). Needed once fleethq-frontend and this API
# are on separate origins — e.g.
# "https://app.fleethq.online,https://fleethq-frontend.vercel.app". Empty/unset
# leaves CORS off entirely (correct only when a proxy/edge serves both under
# one origin).
CORS_ALLOWED_ORIGINS=""

# Require any account holding an admin-tier permission (managing users, roles,
# the security policy, billing, integration credentials, or data erasure) to
# have MFA enabled before login completes — otherwise they're routed to
# MFA setup. On by default in every real environment; set to "false" only to
# stage a rollout. (No effect on non-admin accounts, and a passkey login
# already satisfies the requirement.)
ENFORCE_ADMIN_MFA="true"

# Integration Hub credential vault (10-Integrations/Integration_Hub.md) —
# IntegrationCryptoService encrypts every stored IntegrationCredential's secret
# at rest with AES-256-GCM using this key. Required in every environment (see
# env.validation.ts). The value below is a self-evidently fake PLACEHOLDER and
# is rejected outright in production (env.validation.ts) — generate a real,
# unique key per environment and never ship this one:
#   openssl rand -base64 32     (32-byte key, base64 — the documented default)
#   openssl rand -hex 32        (equally valid — 64 hex characters)
# The value below decodes to the ASCII text "CHANGE-ME-dev-only-not-for-prod!"
# so it is obviously a placeholder — fine for local dev, rejected in production.
INTEGRATION_CREDENTIAL_KEY="Q0hBTkdFLU1FLWRldi1vbmx5LW5vdC1mb3ItcHJvZCE="

# Attachment storage. Unset/empty = attachment bytes (POD photos, fault photos,
# scans) are stored inline in Postgres — the zero-infra default, fine for a
# pilot. Set to a bucket name to store them in S3 instead (recommended before
# real photo volume bloats the DB); uses the same AWS_REGION + credentials as
# SES above. Existing inline rows keep working — the switch only affects new
# uploads.
ATTACHMENTS_BUCKET=""

# --- Boot-time migrations (docker-entrypoint.sh) ---
# By default the container runs `prisma migrate deploy` on every boot before the
# app starts. Set RUN_MIGRATIONS_ON_BOOT=false to skip it when you run
# migrations as a dedicated pre-deploy step instead — recommended once more than
# one instance can boot at a time, so concurrent replicas don't race the same
# schema change.
RUN_MIGRATIONS_ON_BOOT="true"

# --- Boot-time bootstrap (src/bootstrap/prod-bootstrap.ts, run by
# docker-entrypoint.sh after migrations) ---
# On every boot it seeds the permission catalog + built-in asset classes
# (idempotent). Set BOOTSTRAP_ON_BOOT=false to skip it entirely.
BOOTSTRAP_ON_BOOT="true"
# Optionally create the first company + Administrator login (the account you
# sign in to FleetHQ with) on boot. Set BOOTSTRAP_COMPANY_ADMIN=true and provide
# the three required values below; it's idempotent — once that username exists
# it does nothing, so you can safely remove these afterwards. Don't leave a real
# password sitting in deploy config longer than needed.
BOOTSTRAP_COMPANY_ADMIN="false"
BOOTSTRAP_COMPANY_NAME=""
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_FULL_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""

# Optionally create the first FleetHQ *staff* admin — the account that signs in
# to the internal ops console at /admin (a SEPARATE auth realm from the customer
# app above). Set BOOTSTRAP_STAFF_ADMIN=true; the _USERNAME/_PASSWORD/_EMAIL/
# _FULL_NAME fields fall back to the customer BOOTSTRAP_ADMIN_* values if unset,
# so one set of credentials can serve both apps. Created with the Super Admin
# role (full cross-tenant access).
#
# SECURITY — rotate after use, exactly like BOOTSTRAP_COMPANY_ADMIN:
#   * The account is created with mustResetPassword=true, so this password is
#     only valid until the operator's first sign-in, at which point the console
#     forces a one-time password change.
#   * It is idempotent (once the username exists it does nothing), so REMOVE
#     BOOTSTRAP_STAFF_ADMIN and the password from deploy config once the account
#     exists — don't leave a real password sitting in Railway's env indefinitely.
BOOTSTRAP_STAFF_ADMIN="false"
BOOTSTRAP_STAFF_ADMIN_USERNAME=""
BOOTSTRAP_STAFF_ADMIN_PASSWORD=""
BOOTSTRAP_STAFF_ADMIN_FULL_NAME=""
BOOTSTRAP_STAFF_ADMIN_EMAIL=""

# MFA for the staff console is OPTIONAL by default: each admin can enable it from
# Security settings and is then challenged at sign-in, but no one is forced to.
# To MANDATE it (recommended for cross-tenant admin accounts), set this to "true"
# — the console then blocks any un-enrolled admin until they set MFA up. Any
# other value (unset / "false") leaves MFA optional.
ENFORCE_STAFF_ADMIN_MFA="false"
