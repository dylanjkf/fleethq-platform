{
  "name": "@fleetos/api",
  "version": "0.1.0",
  "description": "FleetOS core API — the single versioned API every client (FleetHQ, DriverOS, or a third-party integration) reads and writes through.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "node -r ts-node/register src/main.ts",
    "dev:watch": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "docs:api": "node scripts/generate-api-reference.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "seed:enterprise": "ts-node scripts/seed-enterprise-company.ts",
    "seed:demo": "ts-node scripts/seed-demo-company.ts",
    "permissions:sync": "ts-node prisma/reconcile-permissions.ts",
    "admin:permissions:sync": "ts-node prisma/reconcile-admin-permissions.ts",
    "admin:bootstrap": "ts-node scripts/bootstrap-admin.ts",
    "db:rotate-role-passwords": "ts-node scripts/rotate-db-role-passwords.ts",
    "load-test:seed": "ts-node scripts/seed-load-test-data.ts",
    "load-test": "ts-node scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/client-ses": "^3.1093.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.55.2",
    "@simplewebauthn/server": "^13.3.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "jose": "^4.15.9",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pino-http": "^11.0.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.3.2",
    "uuidv7": "^1.2.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/autocannon": "^7.12.7",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "autocannon": "^7.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bcrypt@6.0.0": true,
    "prisma@5.22.0": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "multer": "2.2.0",
    "lodash": "^4.18.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
